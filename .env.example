# Destino Vivo - Environment Configuration Example

# Google Cloud & Apps Script API
GCP_PROJECT_ID=destino-vivo-mvp
GCP_REGION=us-central1
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id

# Cloud Functions Endpoints
CLOUD_FUNCTION_PRICING_URL=https://us-central1-destino-vivo-mvp.cloudfunctions.net/calculatePricing
CLOUD_FUNCTION_ALERTS_URL=https://us-central1-destino-vivo-mvp.cloudfunctions.net/detectAlerts

# Antigravity App Configuration
ANTIGRAVITY_APP_ID=destino-vivo-mvp
ANTIGRAVITY_ENV=development
